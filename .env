# ══════════════════════════════════════════════════════════════════
# TASKFLOW BACKEND - Environment Configuration
# ══════════════════════════════════════════════════════════════════
#
# LOCAL DEVELOPMENT: Active variables below (uncommented)
# PRODUCTION: Uncomment production section and comment local section
#
# DATABASE SECURITY: Never expose PostgreSQL publicly.
#   - Local: SSH tunnel (ssh -L 5433:127.0.0.1:5432 root@165.245.148.89)
#   - Production: Docker internal network only
# ═══════════════════════════════════════════════════════════════════

# ── Base de datos (LOCAL - vía túnel SSH) ─────────────────────────
DB_HOST=127.0.0.1
DB_PORT=5433
DB_USER=admin
DB_PASS=TaskFlow2026Secure!
DB_NAME=escolar

# ── Base de datos (PRODUCCIÓN - descomentar al desplegar en VPS) ──
# DB_HOST=postgres
# DB_PORT=5432
# DB_USER=admin
# DB_PASS=TaskFlow2026Secure!
# DB_NAME=escolar

# ── JWT ──────────────────────────────────────────────────────────
JWT_SECRET=super_secreto_dev

# ── Webhooks ──────────────────────────────────────────────────────
# Clave compartida con n8n
N8N_SECRET_KEY=taskflow_n8n_secret_2026

# Clave para otros webhooks internos
WEBHOOK_SECRET=taskflow_webhook_secret_2026

# URL del webhook de n8n (LOCAL - apunta al VPS)
N8N_WEBHOOK_URL=http://165.245.148.89:5678/webhook/ics-task-processor

# URL del webhook de n8n (PRODUCCIÓN - red interna Docker)
# N8N_WEBHOOK_URL=http://n8n:5678/webhook/ics-task-processor

# URL de retorno n8n → Backend (PRODUCCIÓN - solo para referencia en workflow de n8n)
# N8N_BACKEND_CALLBACK_URL=http://nestjs_backend:3001/api/webhooks/n8n/task-solution

# ── URL pública del backend (se usa en los links del correo) ───────
# LOCAL
APP_BASE_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://165.245.148.89:3000,http://165.245.148.89:3001

# PRODUCCIÓN (descomentar y reemplazar con tu dominio)
# APP_BASE_URL=https://api.tudominio.com
# CORS_ORIGINS=https://app.tudominio.com,https://api.tudominio.com

# ── SMTP (correo) ─────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=automatizaciones.cloud@gmail.com
# SMTP_PASS debe ser una "Contraseña de aplicación" de Google, NO la contraseña normal.
SMTP_PASS=pertrnarajrokyxx
SMTP_FROM=TaskFlow <automatizaciones.cloud@gmail.com>

# ── AI API Configuration (n8n workflow) ───────────────────────────
# Current: Google Gemini (free tier - 20 req/min limit)
# Alternatives: OpenAI, Claude, Groq, Mistral, OpenRouter
# See AGENTS.md section 6 for details
# GEMINI_API_KEY=AIzaSy... (configured in n8n workflow)
# OPENAI_API_KEY=sk-... (uncomment if switching to OpenAI)
# ANTHROPIC_API_KEY=sk-ant-... (uncomment if switching to Claude)
